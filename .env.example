# Login information for local tests. Copy this file to ".env" and fill in
# the values. ".env" is ignored by git, never commit login information.

# A BioCyc account with subscription, used for the regular tests. CobraMod
# reads these variables itself and prefers them over credentials.txt
BIOCYC_NAME=
BIOCYC_PASSWORD=

# A free BioCyc account, used to test access without a subscription
BIOCYC_FREE_NAME=
BIOCYC_FREE_PASSWORD=
